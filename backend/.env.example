# Export in your shell; Spring Boot does not load .env files automatically.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/superpont
DATABASE_USERNAME=superpont
DATABASE_PASSWORD=
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
PORT=8080

# Backend only. Manual imports are available with a key while scheduling remains off.SPORTSTATS_API_KEY=
SPORTSTATS_SYNC_ENABLED=false
SPORTSTATS_SYNC_INTERVAL=PT30M
SPORTSTATS_DAYS_BACK=7
SPORTSTATS_DAYS_AHEAD=14
# Optional division-code overrides for plain "Week N" rounds; only verified provider codes belong here.
# SPORTSTATS_PHASE_DIVISIONS=dx2=REGULAR

# Local Mailpit (start with: podman compose up -d db mailpit).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLED=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_ENABLED=false
SMTP_FROM=Super Pont <no-reply@superpont.local>

# Real provider example: replace the local SMTP values and keep production off dev.
# SMTP_HOST=smtp.provider.example
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_AUTH=true
# SMTP_STARTTLS_ENABLED=true
# SMTP_STARTTLS_REQUIRED=true
# SMTP_SSL_ENABLED=false
# SMTP_FROM=Super Pont <no-reply@your-verified-domain.example>
# Backend-only persistent image cache (relative to the backend working directory outside Compose).
TEAM_LOGO_CACHE_DIR=./.local-cache/team-logos
TEAM_LOGO_STORAGE=filesystem
TEAM_LOGO_AUTOMATIC_ENABLED=false
TEAM_LOGO_CHECK_INTERVAL=PT5M

# Hosted setup: see ../docs/DEPLOY.md. Do not reuse this dev environment.
# SPRING_PROFILES_ACTIVE=prod
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# MAIL_FROM=Super Pont <your-verified-sender@example.test>
# prod selects database logo storage and disables automatic imports.
