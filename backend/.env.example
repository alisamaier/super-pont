# Export in your shell; Spring Boot does not load .env files automatically.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/superpont
DATABASE_USERNAME=superpont
DATABASE_PASSWORD=
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
PORT=8080

# Local Mailpit (start with: podman compose up -d db mailpit).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLED=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_ENABLED=false
SMTP_FROM=Super Pont <no-reply@superpont.local>

# Real provider example: replace the local SMTP values and keep production off dev.
# SMTP_HOST=smtp.provider.example
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_AUTH=true
# SMTP_STARTTLS_ENABLED=true
# SMTP_STARTTLS_REQUIRED=true
# SMTP_SSL_ENABLED=false
# SMTP_FROM=Super Pont <no-reply@your-verified-domain.example>
