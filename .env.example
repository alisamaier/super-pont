# Local Compose only. Set a non-empty password in your ignored .env file.
POSTGRES_DB=superpont
POSTGRES_USER=superpont
POSTGRES_PASSWORD=
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080

# Backend only. Leave automatic synchronization off until explicitly enabled.
SPORTSTATS_API_KEY=
SPORTSTATS_SYNC_ENABLED=false
SPORTSTATS_SYNC_INTERVAL=PT30M
SPORTSTATS_DAYS_BACK=7
SPORTSTATS_DAYS_AHEAD=14

# Logo refresh stays manual by default; opt-in automatic checks are local only.
TEAM_LOGO_AUTOMATIC_ENABLED=false
TEAM_LOGO_CHECK_INTERVAL=PT5M
# Compose sets TEAM_LOGO_CACHE_DIR=/var/lib/super-pont/logos in a persistent named volume.

# SMTP for a backend started outside Compose. Compose always uses its local Mailpit.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLED=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_ENABLED=false
SMTP_FROM=Super Pont <no-reply@superpont.local>
